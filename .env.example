# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://indexer:indexer@localhost:5432/solana_indexer

# Solana RPC
SOLANA_RPC_HTTP_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com
# Program to index (any valid Solana program address)
# Example: Marinade Finance staking program
SOLANA_PROGRAM_ID=MarBmsSgKXdrN1egZf5sqe1TMai9K1rChYNDJgjq7aD

# IDL Source: "file" or "onchain"
IDL_SOURCE_TYPE=file
IDL_FILE_PATH=./idl/program.json
IDL_ACCOUNT_ADDRESS=

# Indexer Mode: "batch" or "realtime"
INDEXER_MODE=realtime

# Batch Mode Config
BATCH_START_SLOT=
BATCH_END_SLOT=
BATCH_SIGNATURES=
BATCH_SIZE=50

# Realtime Mode Config
REALTIME_CONFIRMATION=confirmed
BACKFILL_ENABLED=true

# Retry / Backoff
RPC_MAX_RETRIES=5
RPC_INITIAL_BACKOFF_MS=500
RPC_MAX_BACKOFF_MS=30000

# Checkpoint
CHECKPOINT_COMMIT_INTERVAL=100

# API Pagination
PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=500
