{
  "version": "0.2.0",
  "name": "token_vault",
  "instructions": [
    {
      "name": "create_vault",
      "accounts": [
        { "name": "vault", "writable": true, "signer": false },
        { "name": "owner", "writable": true, "signer": true },
        { "name": "mint", "writable": false, "signer": false },
        { "name": "tokenProgram", "writable": false, "signer": false },
        { "name": "systemProgram", "writable": false, "signer": false }
      ],
      "args": [
        { "name": "name", "type": "string" },
        { "name": "capacity", "type": "u64" }
      ]
    },
    {
      "name": "deposit",
      "accounts": [
        { "name": "vault", "writable": true, "signer": false },
        { "name": "depositor", "writable": true, "signer": true },
        { "name": "depositorTokenAccount", "writable": true, "signer": false },
        { "name": "vaultTokenAccount", "writable": true, "signer": false },
        { "name": "tokenProgram", "writable": false, "signer": false }
      ],
      "args": [
        { "name": "amount", "type": "u64" }
      ]
    },
    {
      "name": "withdraw",
      "accounts": [
        { "name": "vault", "writable": true, "signer": false },
        { "name": "owner", "writable": true, "signer": true },
        { "name": "vaultTokenAccount", "writable": true, "signer": false },
        { "name": "ownerTokenAccount", "writable": true, "signer": false },
        { "name": "tokenProgram", "writable": false, "signer": false }
      ],
      "args": [
        { "name": "amount", "type": "u64" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "Vault",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "owner", "type": "publicKey" },
          { "name": "mint", "type": "publicKey" },
          { "name": "name", "type": "string" },
          { "name": "capacity", "type": "u64" },
          { "name": "balance", "type": "u64" },
          { "name": "depositors", "type": { "vec": "publicKey" } },
          { "name": "created_at", "type": "i64" }
        ]
      }
    }
  ],
  "types": []
}
